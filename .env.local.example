# ───────────────────────────────────────────────
# آرکان — متغیرهای محیطی
# این فایل را به .env.local کپی کنید و مقادیر را پر کنید.
# ───────────────────────────────────────────────

# Supabase (برای ذخیره‌ی درخواست‌های مشاوره در جدول leads)
# از داشبورد پروژه: Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# پنل مدیریت (/admin) — برای دسترسی مدیر به درخواست‌ها
# ADMIN_PASSWORD: رمزی که مدیر با آن وارد /admin می‌شود (آن را تغییر دهید).
# ADMIN_SESSION_SECRET: یک رشته‌ی تصادفی برای امضای کوکی نشست؛ با این دستور بسازید:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_PASSWORD=یک-رمز-قوی-بگذارید
ADMIN_SESSION_SECRET=یک-رشته-تصادفی-بلند

# ── چت‌بات RAG (فاز ۲) ──────────────────────────────────────────
# تولید پاسخ: همه‌ی مدل‌ها از طریق OpenRouter (یک کلید برای همه)
OPENROUTER_API_KEY=sk-or-xxxxxxxxxxxx
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Embedding: پیش‌فرض همان OpenRouter بالا (نیازی به سرویس/کلید جدا نیست؛
# مناسب کاربران ایران که پرداخت مستقیم به Cohere برایشان ممکن نیست)
EMBEDDING_PROVIDER=openrouter
EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_DIMENSIONS=1024

# جایگزین اختیاری: Cohere چندزبانه (نیاز به کلید و پرداخت جدا از OpenRouter دارد)
# EMBEDDING_PROVIDER=cohere
# EMBEDDING_MODEL=embed-multilingual-v3.0
# COHERE_API_KEY=xxxxxxxxxxxx

# تلگرام
# TELEGRAM_BOT_TOKEN: از @BotFather بگیرید (دستور /newbot)
# TELEGRAM_WEBHOOK_SECRET: یک رشته‌ی تصادفی برای اعتبارسنجی درخواست‌های webhook؛ با این دستور بسازید:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
# TELEGRAM_WEBHOOK_SECRET=

# آدرس عمومی سایت (بدون / انتهایی) — لازم برای فعال‌سازی webhook تلگرام از پنل ادمین.
# روی Vercel بعد از دیپلوی، آدرس واقعی دامنه را اینجا بگذارید.
# NEXT_PUBLIC_SITE_URL=https://your-domain.example.com

# اطلاع‌رسانی ایمیل (اختیاری) — برای فعال‌سازی، قلاب مربوطه را در
# src/app/actions.ts از کامنت خارج کنید.
# RESEND_API_KEY=re_xxxxxxxxxxxx

# نکته: تا زمانی که کلیدهای Supabase تنظیم نشده باشند، فرم در حالت
# «فالبک» کار می‌کند و درخواست‌ها در کنسول سرور لاگ می‌شوند.
